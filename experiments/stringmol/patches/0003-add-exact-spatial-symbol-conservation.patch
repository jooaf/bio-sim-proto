+// Plans byte changes without modifying either molecule. RNG floats and branch
+// movements deliberately match OpcodeCopy, including the mutation-disabled draw.
+void SpatialConservation::copy(s_ag *act, bool domut, float indelrate, float subrate,
+        smith_waterman_table *blosum, int granular, long &biomass,
+        SMspp *spl, unsigned long tick) {
+    s_ag *pass = act->pass;
+    count(act); count(pass); // Validate full buffers and reserved terminators first.
+    attempts = add(attempts, 1);
+    act->len = strlen(act->S); pass->len = strlen(pass->S);
+    const auto offset = [](char *p, char *base) -> int64_t {
+        return static_cast<int64_t>(reinterpret_cast<uintptr_t>(p)) - static_cast<int64_t>(reinterpret_cast<uintptr_t>(base));
+    };
+    int64_t w = offset(act->w[act->wt], act->wt ? act->S : pass->S);
+    int64_t r = offset(act->r[act->rt], act->rt ? act->S : pass->S);
+    bool bad_w = w < 0 || w >= size-1, bad_r = r < 0 || r >= size-1;
+    if (bad_w || bad_r) {
+        printf("%s head out of bounds: %" PRId64 "\n", bad_w ? "Write" : "Read", bad_w ? w : r);
+        categories[BOUNDARY] = add(categories[BOUNDARY], 1);
+        act->i[act->it]++;
+        spl->SpeciesListUpdate(act,'A',1,act->spp,pass->spp,AgentUnbind(act),tick,size);
+        spl->SpeciesListUpdate(pass,'P',1,act->spp,pass->spp,AgentUnbind(pass),tick,size);
+        return;
+    }
+    if (!domut) indelrate = subrate = 0;
+    std::vector<std::pair<char *, char> > writes;
+    if (!*act->r[act->rt]) categories[READ_NULL] = add(categories[READ_NULL], 1);
+    else {
+        float draw = RandomBetween0And1();
+        if (draw < indelrate) {
+            draw = RandomBetween0And1();
+            if (draw < 0.5) {
+                if (w + 1 >= size-1) {
+                    printf("Write head out of bounds: %" PRId64 "\n", w + 1);
+                    categories[BOUNDARY] = add(categories[BOUNDARY], 1);
+                    // Selected insertion completes, but no symbol RNG or byte writes.
+                } else {
+                    writes.push_back(std::make_pair(act->w[act->wt], *act->r[act->rt]));
+                    int index = static_cast<int>(static_cast<float>(RandomBetween0And1()) * blosum->N);
+                    writes.push_back(std::make_pair(act->w[act->wt] + 1, blosum->key[index]));
+                }
+                act->w[act->wt]++;
+                if (!granular) act->w[act->wt]++;
+            } else {
+                categories[DELETION] = add(categories[DELETION], 1);
+                act->i[act->it]++;
+            }
+            if (!granular) act->r[act->rt]++;
+        } else {
+            char proposed = draw < subrate + indelrate ? adjacent(*act->r[act->rt], blosum) : *act->r[act->rt];
+            writes.push_back(std::make_pair(act->w[act->wt], proposed));
+            if (!granular) { act->w[act->wt]++; act->r[act->rt]++; }
+        }
+        if (!writes.empty()) transaction(writes);
+    }
+    act->len = strlen(act->S); pass->len = strlen(pass->S);
+    act->i[act->it]++;
+    act->biomass++; biomass++;
+}
