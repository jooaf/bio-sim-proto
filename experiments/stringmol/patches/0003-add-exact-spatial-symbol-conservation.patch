+// Enabled substitution keeps the native draw even for an invalid rank, but
+// checks it before indexing the alphabet. Disabled execution uses upstream code.
+char SpatialConservation::adjacent(char x, smith_waterman_table *table) {
+    int idx = OpcodeIndex(x, table);
+    float draw = RandomBetween0And1();
+    if (idx < 0 || idx >= table->N) fail("invalid substitution source index");
+    int count = 0;
+    for (int i = 0; i < table->N; ++i)
+        if (table->adj[idx][i] == 1) ++count;
+    int rank = ceil(static_cast<float>(count) * draw);
+    if (rank <= 0 || rank > count) fail("invalid substitution rank");
+    int i = 0;
+    while (rank) {
+        if (i >= table->N) fail("invalid substitution adjacency");
+        if (table->adj[idx][i++] == 1) --rank;
+    }
+    return table->key[i - 1];
+}
