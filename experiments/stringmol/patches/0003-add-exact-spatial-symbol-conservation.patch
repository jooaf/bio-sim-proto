+// SM-C001 spatial full-buffer conservation. Independent of lineage observation.
+#ifndef SM_CONSERVATION_H
+#define SM_CONSERVATION_H
+#include <array>
+#include <vector>
+#include <utility>
+#include <algorithm>
+#include <stdint.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+struct SpatialConservation {
+    typedef std::array<int64_t, 33> Counts;
+    enum Category { BOUNDARY, READ_NULL, DELETION, NOOP, ACCEPTED, BLOCKED };
+    bool enabled = false, initialized = false;
+    unsigned int size = 0;
+    Counts pool{}, initial{}, initial_pool{}, minimum{}, withdrawals{}, returns{},
+           decay{}, failed{}, discard{}, missing{};
+    int64_t attempts = 0, growth = 0;
+    std::array<int64_t, 6> categories{};
+    FILE *aggregate = NULL, *buffers = NULL;
+    static const char *key() { return "ABC$DEF%GH^IJK?LMN}OPQ>RST=UVWXYZ"; }
+    static void fail(const char *message) {
+        fprintf(stderr, "SM-C001 integrity failure: %s\n", message);
+        exit(EXIT_FAILURE);
+    }
+    // Compare integer addresses before any pointer subtraction/dereference.
+    // The reserved terminator is allocated and may be dispatched as native END.
+    static unsigned int allocated_offset(const char *p, const char *base,
+                                         unsigned int allocation) {
+        uintptr_t address = reinterpret_cast<uintptr_t>(p);
+        uintptr_t start = reinterpret_cast<uintptr_t>(base);
+        if (!p || !base || address < start || address - start >= allocation)
+            fail("pointer outside allocated sequence buffer");
+        return static_cast<unsigned int>(address - start);
+    }
+    void instruction(const s_ag *act, const s_ag *pass) const {
+        if (act->it != 0 && act->it != 1) fail("invalid instruction toggle");
+        allocated_offset(act->i[act->it], act->it ? act->S : pass->S, size);
+    }
+    // Same float draw and ceil/rank traversal as native OpcodeAdjacent. A zero
+    // rank has no native symbol (key[-1]); it is an integrity failure, not a
+    // replacement symbol, a clamped draw, or a redraw.
+    static char adjacent(char x, smith_waterman_table *table);
+    static int64_t add(int64_t a, int64_t b) {
+        if (a < 0 || b < 0 || b > INT64_MAX - a) fail("integer overflow");
+        return a + b;
+    }
+    static int symbol(unsigned char c) {
+        if (!c) return -1;
+        const char *p = strchr(key(), c);
+        if (!p) fail("non-ALXII byte");
+        return p - key();
+    }
+    static int64_t amount(const char *s) {
+        if (!s || !*s || (s[0] == '0' && s[1])) fail("noncanonical pool amount");
+        int64_t n = 0;
+        for (; *s; ++s) {
+            if (*s < '0' || *s > '9' || n > (INT64_MAX - (*s - '0')) / 10)
+                fail("invalid/overflow pool amount");
+            n = n * 10 + (*s - '0');
+        }
+        return n;
+    }
+    Counts count(const s_ag *agent) const {
+        Counts result{};
+        if (!agent) return result;
+        if (!agent->S || size < 2 || agent->S[size-1]) fail("invalid buffer/terminator");
+        for (unsigned int i = 0; i < size; ++i) {
+            int s = symbol(static_cast<unsigned char>(agent->S[i]));
+            if (s >= 0) result[s] = add(result[s], 1);
+        }
+        return result;
+    }
+    static Counts sum(const Counts &a, const Counts &b) {
+        Counts c{};
+        for (int s = 0; s < 33; ++s) c[s] = add(a[s], b[s]);
+        return c;
+    }
+    void init(const s_ag *head, unsigned int maxl0, const char *alphabet) {
+        const char *flag = getenv("STRINGMOL_CONSERVATION");
+        if (!flag || strcmp(flag, "1")) return;
+        if (initialized) fail("duplicate initialization");
+        const char *mode = getenv("STRINGMOL_POOL_MODE");
+        if (!mode || (strcmp(mode, "histogram") && strcmp(mode, "uniform"))) fail("invalid pool mode");
+        int64_t n = amount(getenv("STRINGMOL_POOL_AMOUNT"));
+        if (!alphabet || strcmp(alphabet, key())) fail("noncanonical alphabet");
+        if (maxl0 < 2) fail("invalid allocated buffer size");
+        size = maxl0;
+        Counts molecular{};
+        for (const s_ag *a = head; a; a = a->next) molecular = sum(molecular, count(a));
+        for (int s = 0; s < 33; ++s) {
+            int64_t factor = !strcmp(mode, "histogram") ? molecular[s] : 1;
+            if (factor && n > INT64_MAX / factor) fail("pool multiplication overflow");
+            pool[s] = initial_pool[s] = minimum[s] = factor * n;
+            initial[s] = add(molecular[s], pool[s]);
+        }
+        initialized = enabled = true;
+    }
+    void release(const Counts &units, Counts &ledger) {
+        if (!enabled) return;
+        Counts next{}, next_ledger{};
+        for (int s = 0; s < 33; ++s) {
+            next[s] = add(pool[s], units[s]); next_ledger[s] = add(ledger[s], units[s]);
+        }
+        pool = next; ledger = next_ledger;
+        minima();
+    }
+    void minima() {
+        for (int s = 0; s < 33; ++s) minimum[s] = std::min(minimum[s], pool[s]);
+    }
+    // Ordered writes are resolved BEFORE any gross exchange, including aliasing.
+    void transaction(const std::vector<std::pair<char *, char> > &ordered) {
+        std::vector<std::pair<char *, char> > final;
+        for (const auto &w : ordered) {
+            auto it = std::find_if(final.begin(), final.end(), [&w](const std::pair<char *, char> &p) { return p.first == w.first; });
+            if (it == final.end()) final.push_back(w); else it->second = w.second;
+        }
+        Counts in{}, out{};
+        bool changed = false;
+        int delta = 0;
+        for (const auto &w : final) {
+            int old = symbol(*w.first), proposed = symbol(w.second);
+            if (*w.first == w.second) continue;
+            changed = true;
+            if (old >= 0) { ++in[old]; --delta; }
+            if (proposed >= 0) { ++out[proposed]; ++delta; }
+        }
+        if (!changed) { categories[NOOP] = add(categories[NOOP], 1); return; }
+        bool blocked = false;
+        Counts available{}, next_missing = missing;
+        for (int s = 0; s < 33; ++s) {
+            available[s] = add(pool[s], in[s]);
+            if (out[s] > available[s]) {
+                blocked = true;
+                next_missing[s] = add(missing[s], out[s] - available[s]);
+            }
+        }
+        if (blocked) { missing = next_missing; categories[BLOCKED] = add(categories[BLOCKED], 1); return; }
+        Counts next_returns = sum(returns, in), next_withdrawals = sum(withdrawals, out);
+        for (const auto &w : final) *w.first = w.second;
+        for (int s = 0; s < 33; ++s) pool[s] = available[s] - out[s];
+        returns = next_returns; withdrawals = next_withdrawals;
+        categories[ACCEPTED] = add(categories[ACCEPTED], 1);
+        if (delta > 0) growth = add(growth, 1);
+        minima();
+    }
+    void cleave(const Counts &before, const s_ag *act, const s_ag *pass, const s_ag *child) {
+        if (!enabled) return;
+        Counts after = sum(sum(count(act), count(pass)), count(child)), released{};
+        for (int s = 0; s < 33; ++s) {
+            if (after[s] > before[s]) fail("stable cleavage molecular gain");
+            released[s] = before[s] - after[s];
+        }
+        release(released, child ? discard : failed);
+    }
+    void copy(s_ag *act, bool domut, float indelrate, float subrate,
+              smith_waterman_table *blosum, int granular, long &biomass,
+              SMspp *spl, unsigned long tick);
+    static void fields(FILE *f, const char *prefix) {
+        for (int s = 0; s < 33; ++s) fprintf(f, ",%s_%02X", prefix, static_cast<unsigned int>(key()[s]));
+    }
+    static void values(FILE *f, const Counts &c) {
+        for (int s = 0; s < 33; ++s) fprintf(f, ",%" PRId64, c[s]);
+    }
+    void observe(unsigned int tick, const char *event, const s_ag *head) {
+        if (!enabled) return;
+        if (!aggregate) {
+            aggregate = fopen("conservation001.csv", "wx");
+            buffers = fopen("conservation_buffers001.csv", "wx");
+            if (!aggregate || !buffers) fail("observation open");
+            fputs("tick,event", aggregate);
+            for (const char *p : {"molecular", "pool", "initial"}) fields(aggregate, p);
+            fputs(",max_residual,attempts,boundary_error,read_null,deletion_no_write,final_byte_noop,accepted_changed,scarcity_blocked,accepted_positive_growth", aggregate);
+            for (const char *p : {"copy_withdrawals", "copy_returns", "decay_returns", "failed_placement_returns", "cleavage_discard_returns", "missing_blocked_units"}) fields(aggregate, p);
+            fputs(",molecular_bytes,free_bytes", aggregate); fields(aggregate, "pool_minimum"); fputc('\n', aggregate);
+            fputs("tick,event,id,full_buffer_hex\n", buffers);
+        }
+        std::vector<const s_ag *> agents;
+        Counts molecular{};
+        for (const s_ag *a = head; a; a = a->next) { agents.push_back(a); molecular = sum(molecular, count(a)); }
+        std::sort(agents.begin(), agents.end(), [](const s_ag *a, const s_ag *b) { return a->idx < b->idx; });
+        int64_t molecular_bytes = 0, free_bytes = 0, partition = 0;
+        for (int s = 0; s < 33; ++s) {
+            if (add(molecular[s], pool[s]) != initial[s]) fail("nonzero residual");
+            // Reconciliation uses a wide intermediate; each persisted ledger is int64.
+            __int128 reconciled = static_cast<__int128>(initial_pool[s]) - withdrawals[s] + returns[s] + decay[s] + failed[s] + discard[s];
+            if (reconciled != pool[s] || minimum[s] < 0 || minimum[s] > pool[s]) fail("pool reconciliation");
+            molecular_bytes = add(molecular_bytes, molecular[s]); free_bytes = add(free_bytes, pool[s]);
+        }
+        for (int64_t n : categories) partition = add(partition, n);
+        if (partition != attempts || growth > categories[ACCEPTED]) fail("copy partition");
+        fprintf(aggregate, "%u,%s", tick, event);
+        values(aggregate, molecular); values(aggregate, pool); values(aggregate, initial);
+        fprintf(aggregate, ",0,%" PRId64, attempts);
+        for (int64_t n : categories) fprintf(aggregate, ",%" PRId64, n);
+        fprintf(aggregate, ",%" PRId64, growth);
+        for (const Counts *c : {&withdrawals, &returns, &decay, &failed, &discard, &missing}) values(aggregate, *c);
+        fprintf(aggregate, ",%" PRId64 ",%" PRId64, molecular_bytes, free_bytes); values(aggregate, minimum); fputc('\n', aggregate);
+        for (const s_ag *a : agents) {
+            fprintf(buffers, "%u,%s,%d,", tick, event, a->idx);
+            for (unsigned int i = 0; i < size; ++i) fprintf(buffers, "%02X", static_cast<unsigned int>(static_cast<unsigned char>(a->S[i])));
+            fputc('\n', buffers);
+        }
+        if (fflush(aggregate) || fflush(buffers) || ferror(aggregate) || ferror(buffers)) fail("observation write");
+        if (!strcmp(event, "END")) {
+            if (fclose(aggregate) || fclose(buffers)) fail("observation close");
+            aggregate = buffers = NULL;
+        }
+    }
+};
+#endif
