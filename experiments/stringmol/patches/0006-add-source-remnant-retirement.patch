+// SM-B002 source disposition. No random draws; RETAIN is observational only.
+#ifndef SM_RETIREMENT_H
+#define SM_RETIREMENT_H
+#include <set>
+struct SpatialRetirement {
+    bool enabled=false, retire=false, logging=false;
+    int64_t proposals=0, eligible=0, committed=0;
+    FILE *journal=NULL;
+    static void fail(const char *s) { fprintf(stderr,"SM-B002 fatal enforcement: %s\n",s); exit(EXIT_FAILURE); }
+    void init(const SpatialConservation &c) {
+        const char *v=getenv("STRINGMOL_SOURCE_RETENTION");
+        if(v && strcmp(v,"0") && strcmp(v,"1")) fail("invalid enable flag");
+        enabled=v && !strcmp(v,"1");
+        if(!enabled) return;
+        v=getenv("STRINGMOL_SOURCE_DISPOSITION");
+        if(!v || (strcmp(v,"RETAIN") && strcmp(v,"RETIRE"))) fail("invalid disposition");
+        retire=!strcmp(v,"RETIRE");
+        if(!c.enabled || !c.routed || c.sequester) fail("requires exact recycling");
+        v=getenv("STRINGMOL_RETIREMENT_LOG");
+        if(v && strcmp(v,"0") && strcmp(v,"1")) fail("invalid log flag");
+        logging=v && !strcmp(v,"1");
+        if(logging) {
+            if(!c.logging) fail("requires material observation");
+            journal=fopen("source_events006.csv","wx");
+            if(!journal) fail("journal open");
+            fputs("tick,material_index,active,passive,flow_source,flow_offset,source,offset,child,eligible_tick,decision,remnant_hex,source_x,source_y,child_x,child_y,survivor,now_before,next_before,now_after,next_after,proposals,eligible,committed\n",journal);
+            if(fflush(journal)||ferror(journal)) fail("journal header write");
+        }
+    }
+    static std::string hex(const std::string &s) {
+        std::string out; const char *digits="0123456789ABCDEF";
+        for(unsigned char b:s) { out+=digits[b>>4]; out+=digits[b&15]; } return out;
+    }
+    static size_t visible(const std::string &s) { size_t n=s.find('\0'); return n==std::string::npos?s.size():n; }
+    // Independently enumerate all suffix/healing/active-first cleanup explanations.
+    static std::pair<int,int> infer(const SpatialConservation::State &before,
+                                   const SpatialConservation::State &after, int child, int active, int passive) {
+        std::vector<std::pair<int,int> > matches;
+        for(const auto &entry:before) for(size_t o=0;o<visible(entry.second);++o) {
+            auto healed=before;
+            std::string suffix=entry.second.substr(o,visible(entry.second)-o);
+            suffix.resize(entry.second.size(),'\0');
+            if(after.at(child)!=suffix) continue;
+            healed[entry.first].replace(o,visible(entry.second)-o,visible(entry.second)-o,'\0');
+            if(!visible(healed.at(active))) healed.erase(active);
+            else if(!visible(healed.at(passive))) healed.erase(passive);
+            healed[child]=suffix;
+            if(healed==after) matches.push_back({entry.first,static_cast<int>(o)});
+        }
+        if(matches.size()!=1) fail("unknown or ambiguous placed suffix source");
+        return matches[0];
+    }
+    static void validate_list(s_ag *head) {
+        std::set<s_ag *> seen; s_ag *prev=NULL;
+        for(s_ag *p=head;p;p=p->next) { if(!seen.insert(p).second || p->prev!=prev) fail("invalid list"); prev=p; }
+    }
+    static int contains(s_ag *head,s_ag *a) { int n=0; for(s_ag *p=head;p;p=p->next) n+=p==a; return n; }
+    static void detach(s_ag **head,s_ag *a) { if(contains(*head,a)) AgentExtract(head,a); }
+    struct Fault { const char *phase; };
+    static bool selected(const char *phase) {
+        const char *v=getenv("STRINGMOL_RETIREMENT_FAULT");
+        return v && !strcmp(v,phase);
+    }
+    static void validate_fault_name() {
+        const char *v=getenv("STRINGMOL_RETIREMENT_FAULT");
+        if(!v) return;
+        for(const char *step:{"validate","unlink","grid","refund","complete","unbind","append",
+                             "publication","material","death","journal","free_before","free"})
+            if(!strcmp(v,step)) return;
+        fail("unknown injected fault");
+    }
+    // Reversible checkpoints are AFTER the named real operation. The caller
+    // restores its native post-cleavage snapshot before terminating, never RETAIN.
+    static void fault(const char *phase) { if(selected(phase)) throw Fault{phase}; }
+    static void published_fault(const char *phase) {
+        if(selected(phase)) {
+            fprintf(stderr,"SM-B002 unevaluable after publication: %s\n",phase);
+            fail(phase);
+        }
+    }
+};
+#endif
