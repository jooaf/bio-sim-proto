@@ -0,0 +1,119 @@
+// SM-B001: reaction eligibility only. Observation never consumes randomness.
+#ifndef SM_SCHEDULING_H
+#define SM_SCHEDULING_H
+#include <map>
+#include <set>
+#include <string>
+#include <sstream>
+#include <stdint.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct SpatialScheduling {
+    struct Row {
+        const char *event;
+        uint64_t tick, eligible = 0, material = 0;
+        int id = -1, other = -1, active = -1, passive = -1, source = -1;
+        int count = 0, selected = -1, opcode = -1, owner = -1, offset = -1;
+        std::string outcome, ids;
+        Row(const char *e, uint64_t t): event(e), tick(t) {}
+    };
+    bool enabled = false;
+    const char *policy = "DISABLED";
+    uint64_t delay = 0, horizon = 0, sentinel = 0, index = 0;
+    FILE *journal = NULL;
+    std::map<int, uint64_t> children;
+    std::set<int> released, seen;
+    int candidates = 0, selected = -1;
+    static void fail(const char *why) {
+        fprintf(stderr, "SM-B001 boundary failure: %s\n", why);
+        exit(EXIT_FAILURE);
+    }
+    static uint64_t add(uint64_t a, uint64_t b) {
+        if (b > UINT64_MAX-a) fail("eligible tick overflow");
+        return a+b;
+    }
+    bool observing() const { return journal != NULL; }
+    bool tracked() const { return enabled || observing(); }
+    bool eligible(const s_ag *a, uint64_t tick) const {
+        return !enabled || tick >= a->eligible_tick;
+    }
+    void check(const s_ag *a, uint64_t tick) const {
+        if (a && !eligible(a,tick)) fail("early encounter/binding/dispatch");
+    }
+    void emit(const Row &r) {
+        if (!journal) return;
+        index = add(index,1);
+        fprintf(journal,"%s,%" PRIu64 ",%" PRIu64 ",%d,%d,%d,%d,%d,%" PRIu64 ",%s,%d,%d,%s,%d,%d,%d,%" PRIu64 ",%s\n",
+            r.event,r.tick,index,r.id,r.other,r.active,r.passive,r.source,r.eligible,policy,
+            r.count,r.selected,r.outcome.c_str(),r.opcode,r.owner,r.offset,r.material,r.ids.c_str());
+        if (fflush(journal) || ferror(journal)) fail("journal write");
+    }
+    static std::string ids(const s_ag *head) {
+        std::ostringstream s;
+        for (const s_ag *p=head;p;p=p->next) { if(p!=head) s << ';'; s << p->idx; }
+        return s.str();
+    }
+    void init(s_ag *head, uint64_t end, bool material_logging) {
+        const char *flag=getenv("STRINGMOL_SCHEDULING");
+        if (flag && strcmp(flag,"0") && strcmp(flag,"1")) fail("invalid scheduling flag");
+        enabled=flag && !strcmp(flag,"1");
+        if (enabled) {
+            const char *p=getenv("STRINGMOL_SCHEDULING_POLICY");
+            if (!p) fail("missing policy");
+            if (!strcmp(p,"IMMEDIATE")) policy="IMMEDIATE";
+            else if (!strcmp(p,"DELAY500")) { policy="DELAY500"; delay=500; }
+            else if (!strcmp(p,"LOCKED")) policy="LOCKED";
+            else fail("invalid policy");
+        }
+        horizon=end; sentinel=add(end,1);
+        const char *log=getenv("STRINGMOL_SCHEDULING_LOG");
+        if (log && strcmp(log,"0") && strcmp(log,"1")) fail("invalid scheduling log flag");
+        if (log && !strcmp(log,"1")) {
+            if (!material_logging) fail("boundary journal requires material journal");
+            journal=fopen("scheduling_events001.csv","wx");
+            if (!journal) fail("journal open");
+            fputs("event,tick,index,id,other,active,passive,source,eligible_tick,policy,count,selected,outcome,opcode,owner,offset,material_index,ids\n",journal);
+            Row r("START",0); r.eligible=end; r.ids=ids(head); emit(r);
+        }
+        if (tracked()) for (s_ag *p=head;p;p=p->next) {
+            if (!seen.insert(p->idx).second) fail("initial ID reuse");
+            p->eligible_tick=0;
+        }
+    }
+    void birth(s_ag *child, uint64_t tick, int source, int active, int passive, uint64_t transaction) {
+        if (!tracked()) return;
+        if (!seen.insert(child->idx).second) fail("child ID reuse");
+        child->eligible_tick=!strcmp(policy,"LOCKED") ? sentinel : add(add(tick,1),delay);
+        if (!strcmp(policy,"LOCKED") && child->eligible_tick<=tick) fail("locked sentinel not above birth");
+        children[child->idx]=child->eligible_tick;
+        Row r("BIRTH",tick); r.id=child->idx; r.source=source; r.active=active; r.passive=passive;
+        r.eligible=child->eligible_tick; r.material=transaction; emit(r);
+    }
+    void tick(uint64_t t, const s_ag *head) {
+        Row r("TICK",t); if (observing()) { r.ids=ids(head); emit(r); }
+        if (tracked()) for (const s_ag *p=head;p;p=p->next) {
+            if (children.count(p->idx) && t>=p->eligible_tick && !released.count(p->idx)) {
+                if (t!=p->eligible_tick) fail("missed eligibility transition");
+                released.insert(p->idx);
+                Row release("RELEASE",t); release.id=p->idx; release.eligible=p->eligible_tick; emit(release);
+            }
+            if(p->status!=B_UNBOUND) check(p,t);
+        }
+    }
+    void death(uint64_t t, const s_ag *p, const char *cause, uint64_t transaction) {
+        if (!tracked()) return;
+        Row r("DEATH",t); r.id=p->idx; r.eligible=p->eligible_tick; r.outcome=cause; r.material=transaction; emit(r);
+    }
+    void end(uint64_t t, const s_ag *head, uint64_t material) {
+        if (!journal) return;
+        for (const s_ag *p=head;p;p=p->next) if(children.count(p->idx)) {
+            Row r("CENSOR",t); r.id=p->idx; r.eligible=p->eligible_tick; emit(r);
+        }
+        Row r("END",t); r.ids=ids(head); r.material=material; emit(r);
+        if (fclose(journal)) fail("journal close"); journal=NULL;
+    }
+};
+#endif
