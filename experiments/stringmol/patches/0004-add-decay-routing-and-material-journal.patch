+    Counts histogram(const State &m) const {
+        Counts c{};
+        for (const auto &a : m) for (unsigned char b : a.second) {
+            int s = symbol(b); if (s >= 0) c[s] = add(c[s], 1);
+        }
+        return c;
+    }
+    void decay_release(const s_ag *a) {
+        Counts units = count(a);
+        if (!routed) { release(units, decay); return; }
+        Counts next_decay = sum(decay, units);
+        if (sequester) {
+            Counts next_waste = sum(waste, units), next_route = sum(decay_waste, units);
+            waste = next_waste; decay_waste = next_route;
+        } else release(units, decay_pool);
+        decay = next_decay;
+    }
+    void open_journal() {
+        if (journal || !logging) return;
+        journal = fopen("material_events002.csv", "wx");
