+            if (decay[s] != add(decay_pool[s],decay_waste[s]) || waste[s] != decay_waste[s]) fail("decay reconciliation");
+            __int128 p = static_cast<__int128>(initial_pool[s])-withdrawals[s]+returns[s]+decay_pool[s]+failed[s]+discard[s];
+            if (p != pool[s]) fail("operation pool reconciliation");
+        }
+        event_index = add(event_index, 1);
+        if (!logging) return;
+        open_journal();
+        fprintf(journal, "%u,%" PRId64 ",%s,%s,%s,%s,%s,%s\n", tick, event_index, event, outcome,
+                ids(before).c_str(), ids(after).c_str(), changes(before,after).c_str(), plan.c_str());
+        if (fflush(journal) || ferror(journal)) fail("journal write");
     }
