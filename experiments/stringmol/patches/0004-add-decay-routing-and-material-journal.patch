+        fputs("tick,index,event,outcome,before_ids,after_ids,changes,proposal\n", journal);
+    }
+    static std::string ids(const State &m) {
+        std::ostringstream out; bool first = true;
+        for (const auto &a : m) { if (!first) out << ';'; first = false; out << a.first; }
+        return out.str();
+    }
+    std::string changes(const State &before, const State &after) const {
+        State both = before; both.insert(after.begin(), after.end());
+        std::ostringstream out; bool first = true;
+        for (const auto &a : both) for (unsigned int i=0; i<size; ++i) {
+            unsigned int old = before.count(a.first) ? static_cast<unsigned char>(before.at(a.first)[i]) : 0;
+            unsigned int now = after.count(a.first) ? static_cast<unsigned char>(after.at(a.first)[i]) : 0;
+            if (old == now) continue;
+            char text[96]; snprintf(text, sizeof(text), "%d:%u:%02X:%02X", a.first, i, old, now);
+            if (!first) out << ';'; first = false; out << text;
+        }
+        return out.str();
+    }
+    std::string proposed(const s_ag *a, const s_ag *b) const {
+        State before = state(a,b), after = before;
+        for (const auto &w : proposal) {
+            bool found = false;
+            for (const s_ag *p : {a,b}) {
+                uintptr_t addr = reinterpret_cast<uintptr_t>(w.first), base = reinterpret_cast<uintptr_t>(p->S);
+                if (addr >= base && addr-base < size) {
+                    after[p->idx][addr-base] = w.second; found = true; break;
+                }
+            }
+            if (!found) fail("proposal outside participating buffers");
+        }
+        return changes(before, after);
+    }
+    void material(unsigned int tick, const char *event, const char *outcome,
+                  const State &before, const State &after, const std::string &plan = "") {
+        if (!routed) return;
+        Counts old = histogram(before), now = histogram(after);
+        for (int s=0; s<33; ++s) {
+            if (stable_molecular[s] < old[s]) fail("journal negative molecular");
